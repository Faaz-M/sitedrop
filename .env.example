# Copy these into your host's environment settings (or run: export $(cat .env | xargs))
ADMIN_PASSWORD=choose-a-long-password
SECRET=long-random-string
SITE_URL=https://yourdomain.in
BIZ_NAME=SiteDrop
BIZ_LEGAL_NAME=Your Registered Business Name
BIZ_GSTIN=
BIZ_ADDRESS=Your address, Bengaluru, Karnataka
BIZ_PHONE=
BIZ_EMAIL=
BIZ_WHATSAPP=91XXXXXXXXXX
DELIVERY_FEE=49
FREE_DELIVERY_ABOVE=500
PIN_FROM=560001
PIN_TO=560105
GST_RATE=18
# Optional: online payments (Razorpay) and order alerts (Make/Zapier/WhatsApp provider webhook)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NOTIFY_WEBHOOK=
TRUST_PROXY=1
# Customer login by SMS code. Use ONE of: Twilio, or any SMS gateway reachable by webhook.
# With neither set, codes are only printed in the server log (testing mode).
SMS_PROVIDER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SMS_WEBHOOK=
# Set to 1 to make customers log in before ordering
REQUIRE_LOGIN=0
# Razorpay dashboard > Webhooks: URL https://yourdomain.in/api/pay/webhook, events payment.captured and order.paid
RAZORPAY_WEBHOOK_SECRET=
